PORT=3000
MONGODB_URI=mongodb://localhost:27017/cpen321

# --- External APIs (not Docker services — each developer needs their own keys) ---

# Google OAuth / Sign-In (Google Cloud Console → APIs & Services → Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google Calendar API (same Google Cloud project; enable Calendar API)
# Redirect URI must match what you register in the console.
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:3000/auth/google/callback

# The Movie Database — https://www.themoviedb.org/settings/api
TMDB_API_KEY=
